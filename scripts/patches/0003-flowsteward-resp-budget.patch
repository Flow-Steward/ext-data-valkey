--- /dev/null
+++ b/internal/proto/flow_steward_limits.go
@@ -0,0 +1,89 @@
+package proto
+
+import (
+	"errors"
+	"fmt"
+)
+
+const (
+	// Leave room above the extension's 1 MiB output cap for RESP overhead
+	// and connection initialization, while bounding bytes below the decoder.
+	maxReplyWireBytes = 2 * 1024 * 1024
+	maxReplyLineBytes = 64 * 1024
+	maxReplySlots     = 32 * 1024
+	maxReplyDepth     = 64
+)
+
+var errReplyLimit = errors.New("redis: native reply exceeded its limit")
+
+func (r *Reader) replyLimit(reason string) error {
+	// A rejected header may leave its body unread. Do not interpret any
+	// remaining bytes as a fresh reply, even if an optional read failed.
+	r.fatalErr = fmt.Errorf("%w (%s)", errReplyLimit, reason)
+	return r.fatalErr
+}
+
+func (r *Reader) checkReplyHeader(line []byte) error {
+	if r.budgetDepth == 0 {
+		if r.slots == 0 {
+			return r.replyLimit("reply elements")
+		}
+		r.slots--
+	} else {
+		r.pending[r.budgetDepth-1]--
+	}
+
+	children, err := r.checkReplyLength(line)
+	if err != nil {
+		return err
+	}
+	if children > 0 {
+		if r.budgetDepth == len(r.pending) {
+			return r.replyLimit("reply nesting")
+		}
+		r.slots -= children
+		r.pending[r.budgetDepth] = children
+		r.budgetDepth++
+	}
+	for r.budgetDepth > 0 && r.pending[r.budgetDepth-1] == 0 {
+		r.budgetDepth--
+	}
+	return nil
+}
+
+func (r *Reader) checkReplyLength(line []byte) (int, error) {
+	switch line[0] {
+	case RespString, RespVerbatim, RespBlobError:
+		n, err := replyLen(line)
+		if err != nil && err != Nil {
+			return 0, err
+		}
+		// Count prefetch once. Compare before the decoder adds the CRLF bytes
+		// to the declared length and allocates the body.
+		if err == nil && int64(n) > r.wire.N+int64(r.rd.Buffered())-2 {
+			return 0, r.replyLimit("wire bytes")
+		}
+	case RespArray, RespSet, RespPush, RespMap, RespAttr:
+		n, err := replyLen(line)
+		if err == Nil {
+			return 0, nil
+		}
+		if err != nil {
+			return 0, err
+		}
+		width, extra := 1, 0
+		if line[0] == RespMap || line[0] == RespAttr {
+			width = 2
+		}
+		if line[0] == RespAttr {
+			// Attributes wrap the subsequent reply. Account for it so chains
+			// also consume nesting in ReadLine, raw reads, and type peeks.
+			extra = 1
+		}
+		if r.slots < extra || n > (r.slots-extra)/width {
+			return 0, r.replyLimit("reply elements")
+		}
+		return n*width + extra, nil
+	}
+	return 0, nil
+}
diff --git a/internal/proto/flow_steward_limits_test.go b/internal/proto/flow_steward_limits_test.go
new file mode 100644
index 0000000..640b4a2
--- /dev/null
+++ b/internal/proto/flow_steward_limits_test.go
@@ -0,0 +1,169 @@
+package proto
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestFlowStewardOrdinaryReplies(t *testing.T) {
+	const handshake = "%2\r\n+server\r\n+redis\r\n+proto\r\n:3\r\n"
+	const attributes = "|1\r\n+source\r\n+cache\r\n"
+	const list = "*3\r\n$5\r\nhello\r\n$-1\r\n*0\r\n"
+	const set = "~2\r\n#t\r\n=9\r\ntxt:hello\r\n"
+	r := NewReader(strings.NewReader(handshake + "+OK\r\n" + attributes + list + ":42\r\n" + set))
+	want := []any{
+		map[any]any{"server": "redis", "proto": int64(3)},
+		"OK",
+		[]any{"hello", nil, []any{}},
+		int64(42),
+		[]any{true, "hello"},
+	}
+	for _, expected := range want {
+		reply, err := r.ReadReply()
+		if err != nil || !reflect.DeepEqual(reply, expected) {
+			t.Fatalf("ReadReply() = (%#v, %v), want %#v", reply, err, expected)
+		}
+	}
+}
+
+func TestFlowStewardHeaderSpansBufferedReads(t *testing.T) {
+	const status = "a regular simple string larger than the test buffer"
+	r := NewReaderSize(strings.NewReader("+"+status+"\r\n"), 16)
+	if got, err := r.ReadString(); err != nil || got != status {
+		t.Fatalf("ReadString() = (%q, %v), want %q", got, err, status)
+	}
+}
+
+func TestFlowStewardWireBudgetCoversPrefetchAndReset(t *testing.T) {
+	const status = "+OK\r\n"
+	const value = "$5\r\nhello\r\n"
+	reader := NewReader(strings.NewReader(status + value))
+	reader.wire.N = int64(len(status+value) - 1)
+
+	if got, err := reader.ReadString(); err != nil || got != "OK" {
+		t.Fatalf("first ReadString() = (%q, %v), want OK", got, err)
+	}
+	if _, err := reader.ReadLine(); !errors.Is(err, errReplyLimit) {
+		t.Fatalf("ReadLine() = %v, want a limit error before decoding the body", err)
+	}
+	if _, err := reader.ReadReply(); !errors.Is(err, errReplyLimit) {
+		t.Fatalf("subsequent ReadReply() = %v, want a persistent limit error", err)
+	}
+
+	reader.Reset(strings.NewReader(value))
+	reader.wire.N = int64(len(value))
+	if got, err := reader.ReadString(); err != nil || got != "hello" {
+		t.Fatalf("ReadString() at the exact wire limit = (%q, %v), want hello", got, err)
+	}
+}
+
+func TestFlowStewardSlotBudgetCoversTypedAggregateHeaders(t *testing.T) {
+	for _, tt := range []struct {
+		name  string
+		wire  string
+		slots int
+		read  func(*Reader) (int, error)
+	}{
+		{"array", "*2\r\n+one\r\n+two\r\n", 2, (*Reader).ReadArrayLen},
+		{"map", "%1\r\n+key\r\n+value\r\n", 2, (*Reader).ReadMapLen},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			reader := NewReader(strings.NewReader(tt.wire))
+			reader.slots = tt.slots
+			if count, err := tt.read(reader); count != 0 || !errors.Is(err, errReplyLimit) {
+				t.Fatalf("typed length = (%d, %v), want a limit error before allocation", count, err)
+			}
+		})
+	}
+}
+
+func TestFlowStewardRecursiveReadModesShareSlotBudget(t *testing.T) {
+	const nested = "*1\r\n*2\r\n+one\r\n+two\r\n"
+	for _, tt := range []struct {
+		name string
+		read func(*Reader) error
+	}{
+		{"decoded", func(r *Reader) error { _, err := r.ReadReply(); return err }},
+		{"raw", func(r *Reader) error { _, err := r.ReadRawReply(); return err }},
+		{"stream", func(r *Reader) error { _, err := r.ReadRawReplyWriteTo(&bytes.Buffer{}); return err }},
+		{"discard", (*Reader).DiscardNext},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			reader := NewReader(strings.NewReader(nested))
+			reader.slots = 3
+			if err := tt.read(reader); !errors.Is(err, errReplyLimit) {
+				t.Fatalf("read = %v, want a limit error for cumulative child slots", err)
+			}
+		})
+	}
+}
+
+func TestFlowStewardAttributeDepthAlsoBoundsPeek(t *testing.T) {
+	const attributes = "|1\r\n+first\r\n+value\r\n|1\r\n+second\r\n+value\r\n+OK\r\n"
+	reader := NewReader(strings.NewReader(attributes))
+	if got, err := reader.PeekReplyType(); err != nil || got != RespStatus {
+		t.Fatalf("PeekReplyType() = (%q, %v), want a status", got, err)
+	}
+	if got, err := reader.ReadString(); err != nil || got != "OK" {
+		t.Fatalf("ReadString() = (%q, %v), want OK", got, err)
+	}
+
+	reader.Reset(strings.NewReader(attributes))
+	reader.pending = reader.pending[:1]
+	if _, err := reader.PeekReplyType(); !errors.Is(err, errReplyLimit) {
+		t.Fatalf("PeekReplyType() = %v, want an attribute depth limit error", err)
+	}
+}
+
+type flowStewardOneReadTimeout struct {
+	io.Reader
+}
+
+func (r flowStewardOneReadTimeout) Read(p []byte) (int, error) {
+	n, err := r.Reader.Read(p)
+	if err == nil {
+		err = errors.New("test read timeout")
+	}
+	return n, err
+}
+
+func TestFlowStewardCachedReadErrorKeepsWireBudget(t *testing.T) {
+	for _, tt := range []struct {
+		name   string
+		cached string
+	}{
+		{name: "empty"},
+		{name: "buffered", cached: "+CACHED\r\n"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			const first = "+OK\r\n"
+			const next = "+NEXT\r\n"
+			src := io.MultiReader(
+				flowStewardOneReadTimeout{strings.NewReader(first + tt.cached)},
+				strings.NewReader(next+"+EXTRA\r\n"),
+			)
+			r := NewReader(src)
+			r.wire.N = int64(len(first + tt.cached + next))
+
+			if got, err := r.ReadString(); err != nil || got != "OK" {
+				t.Fatalf("first reply = (%q, %v), want OK", got, err)
+			}
+			r.DiscardCachedReadError()
+			if tt.cached != "" {
+				if got, err := r.ReadString(); err != nil || got != "CACHED" {
+					t.Fatalf("cached reply = (%q, %v), want CACHED", got, err)
+				}
+			}
+			if got, err := r.ReadString(); err != nil || got != "NEXT" {
+				t.Fatalf("next reply = (%q, %v), want NEXT", got, err)
+			}
+			if got, err := r.ReadString(); got != "" || !errors.Is(err, errReplyLimit) {
+				t.Fatalf("reply past budget after resetting cached error = (%q, %v), want a limit error", got, err)
+			}
+		})
+	}
+}
