diff --git a/internal/sources/redis/flowsteward_callpath_test.go b/internal/sources/redis/flowsteward_callpath_test.go
new file mode 100644
index 0000000000..8a91f8403b
--- /dev/null
+++ b/internal/sources/redis/flowsteward_callpath_test.go
@@ -0,0 +1,39 @@
+package redis
+
+import (
+	"context"
+	"errors"
+	redisclient "github.com/redis/go-redis/v9"
+	"testing"
+)
+
+type workflowCommandClient struct {
+	calls int
+	err   error
+}
+
+func (c *workflowCommandClient) Do(ctx context.Context, args ...any) *redisclient.Cmd {
+	c.calls++
+	cmd := redisclient.NewCmd(ctx, args...)
+	cmd.SetErr(c.err)
+	return cmd
+}
+func TestFlowStewardCommandCallPath(t *testing.T) {
+	ctx := context.Background()
+	client := &workflowCommandClient{}
+	source := &Source{Client: client}
+	if _, err := source.RunCommand(ctx, [][]any{{"GET", "one"}, {"GET", "two"}}); err == nil || client.calls != 0 {
+		t.Fatalf("multiple commands dispatched: %d %v", client.calls, err)
+	}
+	client.err = redisclient.Nil
+	value, err := source.RunCommand(ctx, [][]any{{"GET", "missing"}})
+	if err != nil || len(value.([]any)) != 1 || value.([]any)[0] != nil {
+		t.Fatalf("nil response changed: %#v %v", value, err)
+	}
+	expected := errors.New("provider write failure")
+	client.err = expected
+	before := client.calls
+	if _, err := source.RunCommand(ctx, [][]any{{"SET", "one", "value"}}); !errors.Is(err, expected) || client.calls != before+1 {
+		t.Fatalf("write failure swallowed/retried: %d %v", client.calls, err)
+	}
+}
